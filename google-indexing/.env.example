# Path to Google Cloud service account JSON key file
# Setup: Cloud Console > IAM > Service Accounts > Create > Download JSON key
# Then: Search Console > Settings > Users > Add service account email as Owner
GOOGLE_INDEXING_KEY_FILE=/path/to/service-account-key.json

# Bing Webmaster Tools account-level API key
# Generate at: Bing Webmaster Tools > Settings > API access
BING_WEBMASTER_API_KEY=your_api_key_here
