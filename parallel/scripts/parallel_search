#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "parallel-web>=1.3.3",
#     "python-dotenv",
#     "typer",
# ]
# ///
"""
Parallel Web Search Skill

Agentic web search via the Parallel AI Search API, returning cited excerpts
in a token-efficient shape for LLM consumption.
"""

from __future__ import annotations

import json
import os
from dataclasses import dataclass
from enum import Enum
from typing import Annotated

import typer
from dotenv import load_dotenv
from parallel import APIError, Parallel

# --- Config ---

DEFAULT_MAX_RESULTS = 10
DEFAULT_MAX_CHARS = 500  # per result; concise for agentic workflows

load_dotenv()

app = typer.Typer(help="Agentic web search using the Parallel AI Search API")


# --- Types ---


class OutputFormat(str, Enum):
    json = "json"
    table = "table"


class SearchMode(str, Enum):
    """Mode presets: turbo/fast are the cheap tier, basic/advanced the deep one."""

    turbo = "turbo"
    fast = "fast"
    basic = "basic"
    advanced = "advanced"


# --- Models ---


@dataclass
class SearchResult:
    """Normalized search result."""

    title: str
    url: str
    excerpt: str
    publish_date: str | None = None


@dataclass
class SearchResponse:
    """Response containing search results."""

    objective: str
    queries: list[str]
    mode: str
    results: list[SearchResult]


# --- Client ---


def getClient() -> Parallel:
    """Create Parallel client from environment."""
    api_key = os.getenv("PARALLEL_API_KEY")

    if not api_key:
        typer.echo("Error: PARALLEL_API_KEY required", err=True)
        raise typer.Exit(1)

    return Parallel(api_key=api_key)


def search(
    client: Parallel,
    objective: str,
    queries: list[str] | None = None,
    mode: str = SearchMode.fast.value,
    max_results: int = DEFAULT_MAX_RESULTS,
    max_chars: int = DEFAULT_MAX_CHARS,
    include_domains: list[str] | None = None,
) -> SearchResponse:
    """Perform agentic web search."""
    # search_queries is required; fall back to the objective as a single query.
    search_queries = queries or [objective]

    advanced: dict = {
        "max_results": max_results,
        "excerpt_settings": {"max_chars_per_result": max_chars},
    }
    if include_domains:
        advanced["source_policy"] = {"include_domains": include_domains}

    response = client.search(
        objective=objective,
        search_queries=search_queries,
        mode=mode,
        advanced_settings=advanced,
    )

    results = [
        SearchResult(
            title=item.title or "",
            url=item.url or "",
            excerpt=" ".join(item.excerpts) if item.excerpts else "",
            publish_date=item.publish_date,
        )
        for item in response.results[:max_results]
    ]

    return SearchResponse(
        objective=objective,
        queries=search_queries,
        mode=mode,
        results=results,
    )


# --- Formatters ---


def formatTable(response: SearchResponse) -> str:
    """Format search results as table."""
    lines = []
    lines.append(f"Objective: {response.objective}")
    lines.append(f"Queries: {', '.join(response.queries)} (mode={response.mode})")
    lines.append("")
    lines.append(f"{'#':<3} {'Title':<50} {'URL':<40}")
    lines.append("-" * 95)

    for i, r in enumerate(response.results, 1):
        title = r.title[:48] + ".." if len(r.title) > 50 else r.title
        url = r.url[:38] + ".." if len(r.url) > 40 else r.url
        lines.append(f"{i:<3} {title:<50} {url:<40}")
        if r.excerpt:
            excerpt = r.excerpt[:200] + "..." if len(r.excerpt) > 200 else r.excerpt
            lines.append(f"    {excerpt}")
        lines.append("")

    return "\n".join(lines)


def formatJson(response: SearchResponse) -> str:
    """Format results as JSON for LLM consumption."""
    data = {
        "objective": response.objective,
        "queries": response.queries,
        "mode": response.mode,
        "results": [
            {
                "title": r.title,
                "url": r.url,
                "excerpt": r.excerpt,
                "publish_date": r.publish_date,
            }
            for r in response.results
        ],
    }
    return json.dumps(data, indent=2)


# --- Commands ---


@app.command("search")
def searchCmd(
    objective: Annotated[
        str, typer.Option("--objective", "-o", help="Natural language search goal")
    ],
    queries: Annotated[
        list[str] | None,
        typer.Option(
            "--query", "-q", help="Keyword queries, 3-6 words each (repeatable)"
        ),
    ] = None,
    mode: Annotated[
        SearchMode, typer.Option("--mode", "-m", help="Search mode preset")
    ] = SearchMode.fast,
    limit: Annotated[
        int, typer.Option("--limit", "-n", help="Max results (1-20)")
    ] = DEFAULT_MAX_RESULTS,
    max_chars: Annotated[
        int, typer.Option("--max-chars", "-c", help="Max excerpt chars per result")
    ] = DEFAULT_MAX_CHARS,
    domains: Annotated[
        list[str] | None,
        typer.Option(
            "--domain", "-d", help="Restrict results to these domains (repeatable)"
        ),
    ] = None,
    format: Annotated[
        OutputFormat, typer.Option("--format", "-f", help="Output format")
    ] = OutputFormat.json,
) -> None:
    """Perform agentic web search."""
    if not 1 <= limit <= 20:
        typer.echo("Error: --limit must be between 1 and 20", err=True)
        raise typer.Exit(1)

    client = getClient()

    try:
        response = search(
            client=client,
            objective=objective,
            queries=queries,
            mode=mode.value,
            max_results=limit,
            max_chars=max_chars,
            include_domains=domains,
        )

        if format == OutputFormat.table:
            typer.echo(formatTable(response))
        else:
            typer.echo(formatJson(response))

    except APIError as e:
        typer.echo(f"API Error: {e}", err=True)
        raise typer.Exit(1)


if __name__ == "__main__":
    app()
